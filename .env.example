# Django automatically loads .env from the project root.
FIRECRAWL_BASE_URL=http://127.0.0.1:3002
# FIRECRAWL_API_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
# Fill both keys to enable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Set true to inspect prompts, answers and tool payloads during local learning.
LANGFUSE_CAPTURE_CONTENT=false
# Also capture private conversation/case payloads; local debugging only.
LANGFUSE_CAPTURE_PRIVATE_CONTENT=false

# Independently configurable planner models (subscription model names).
SIMPLE_QUERY_MODEL=gpt-6.2-sol
COMPLEX_QUERY_MODEL=gpt-6.2-sol

# Owner-only Telegram research (numeric user ID, not username).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Dedicated application PostgreSQL database (separate from Langfuse/Firecrawl).
POSTGRES_DB=personal_agent
POSTGRES_USER=personal_agent
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
# Gmail Desktop OAuth configuration; store the JSON under ignored .local/, never tokens here.
GMAIL_CLIENT_FILE=
