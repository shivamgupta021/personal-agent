# Django automatically loads .env from the project root.
FIRECRAWL_BASE_URL=http://127.0.0.1:3002
# FIRECRAWL_API_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
# Fill both keys to enable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Set true to inspect prompts, answers and tool payloads during local learning.
LANGFUSE_CAPTURE_CONTENT=false
